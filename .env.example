TAG=latest
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=change-me
#PG_DATABASE_HOST=db
#PG_DATABASE_PORT=5432
#REDIS_URL=redis://redis:6379

SERVER_URL=http://localhost:3000

# Use openssl rand -base64 32 for each secret
ENCRYPTION_KEY=change-me
# FALLBACK_ENCRYPTION_KEY= # set to the previous ENCRYPTION_KEY during a rotation
# APP_SECRET= # legacy: only required for instances that pre-date ENCRYPTION_KEY

STORAGE_TYPE=local
# STORAGE_S3_REGION=eu-west3
# STORAGE_S3_NAME=my-bucket
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Chatwoot
CHATWOOT_SECRET_KEY_BASE=change-me

# Fill after Chatwoot and Twenty are running.
CHATWOOT_API_TOKEN=
TWENTY_API_KEY=

# Middleware
MIDDLEWARE_WEBHOOK_SECRET=change-me

# Instagram（Meta Graph API，需先在 Meta 后台创建 App + 绑定 Instagram 专业账号）
GRAPH_API_VERSION=v21.0
# Meta 后台配置 webhook 回调时填写的校验字符串，自己定义即可
INSTAGRAM_VERIFY_TOKEN=change-me
# Meta App 的 App Secret，用于校验 webhook 请求签名（X-Hub-Signature-256）
INSTAGRAM_APP_SECRET=
# Instagram 专业账号绑定的 Facebook Page 的长期访问令牌
INSTAGRAM_PAGE_ACCESS_TOKEN=

# Meta 通用配置。Instagram 与 Facebook 主页可共用同一个 Meta App；
# 建议新增部署时使用这组名称，旧的 INSTAGRAM_* 配置仍兼容。
META_VERIFY_TOKEN=change-me
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
# 未单独填写时，会自动使用 META_PAGE_ACCESS_TOKEN。
FACEBOOK_PAGE_ACCESS_TOKEN=
